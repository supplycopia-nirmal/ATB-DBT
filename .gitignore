# ==============================================================================
# Ask The Bee - Autonomous DBT Studio .gitignore
# Strictly prevents leaking credentials, large datasets, and database binaries
# ==============================================================================

# Security & Secrets (PUBLIC REPOSITORY SAFETY)
.env
*.env
*.p8
*.pem
*.key
*.token
*.secret

# Database & Engine Binaries
*.duckdb
*.duckdb.wal
*.duckdb.tmp*
*.sqlite
*.sqlite3
*.db

# Data Lake, Raw Files & Large Archives
*.csv
*.tsv
*.xlsx
*.parquet
*.zip
*.tar
*.gz
*.pdf
Consumption/
Spend/
Data/
Production historic files/
KT Documents/
agent_memory/
output/
logs/
*.txt
!requirements.txt

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# OS & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
